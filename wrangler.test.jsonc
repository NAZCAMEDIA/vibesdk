{
	// Test configuration for vitest/miniflare
	// Placeholder IDs are intentional - miniflare creates in-memory databases/namespaces
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vibesdk-test",
	"main": "worker/index.ts",
	"compatibility_date": "2024-12-12",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "vibesdk-test-db",
			// Placeholder ID - miniflare creates in-memory D1 database for tests
			"database_id": "test-db-id"
		}
	],
	"kv_namespaces": [
		{
			"binding": "VibecoderStore",
			// Placeholder ID - miniflare creates in-memory KV namespace for tests
			"id": "test-kv-id"
		}
	],
	"vars": {
		"ENVIRONMENT": "test",
		"CLOUDFLARE_AI_GATEWAY": "test-gateway"
	}
}
